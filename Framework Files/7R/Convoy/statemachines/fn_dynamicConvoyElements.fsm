                                        condition=/*%FSM<CONDITION""">*/"time > _future && ( count _newConvoy > 0 )"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
