                class terminate
                {
                        name = "terminate";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"if (SR_Debug) then { diag_log ""DCS: dynamic convoy system terminated"" };" \n
                         "" \n
                         "_leaderVeh setVariable [""convoy_terminate"", true, true];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "resume">*/
                class resume
                {
                        name = "resume";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"_leaderVeh setVariable [""convoy_stopped"", false, true];" \n
                         "" \n
                         "if (SR_Debug) then { diag_log ""DCS: resuming..."" };"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 20;
                                        priority = 0.000000;
                                        to="initialize_loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "ambush">*/
                class ambush
                {
                        name = "ambush";
                        itemno = 21;
                        init = /*%FSM<STATEINIT""">*/"_leaderVeh setVariable [""convoy_terminate"", true, true];" \n
                         "" \n
                         "if ((_logic getVariable [""behaviourConv"",-1]) == ""pushThroughContact"") then {" \n
                         "	{" \n
                         "		private _vehicle = _x;" \n
                         "		private _commander = effectiveCommander _vehicle;" \n
                         "		private _commandersGroup = group _commander;" \n
                         "" \n
                         "		{[(_x select 0)] join _commandersGroup} forEach (fullCrew [_vehicle, ""Gunner"", true]);" \n
                         "		{[(_x select 0)] join _commandersGroup} forEach (fullCrew [_vehicle, ""Driver"", true]);" \n
                         "		{[(_x select 0)] join _commandersGroup} forEach (fullCrew [_vehicle, ""Turret"", true]);" \n
                         "		{[(_x select 0)] join _commandersGroup} forEach (fullCrew [_vehicle, ""Commander"", true]);" \n
                         "	" \n
                         "		" \n
                         "	} forEach _groupVehicles;" \n
                         "};" \n
                         "" \n
                         "[_groupVehicles] spawn fw_fnc_convoyAmbushed;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
