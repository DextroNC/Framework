                class create_new_convo
                {
                        name = "create_new_convo";
                        itemno = 26;
                        init = /*%FSM<STATEINIT""">*/"[_logic,_newConvoy, _logic getVariable [""convWaypoints"",[]]] call fw_fnc_initConvoy;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
