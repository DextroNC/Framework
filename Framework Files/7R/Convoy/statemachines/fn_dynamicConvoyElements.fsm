                                        condition=/*%FSM<CONDITION""">*/"!(_vehicle getVariable [""driverIncapacitated"", -1])"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
