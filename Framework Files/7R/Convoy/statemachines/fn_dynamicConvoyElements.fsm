                {
                        name = "sleep";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"private _future = time + 1;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
