                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "stop_convoy">*/
                class stop_convoy
                {
                        name = "stop_convoy";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"_leaderVeh setVariable [""convoy_stopped"", true, true];" \n
                         "" \n
                         "//if (SR_Debug) then { diag_log ""DCS: waiting for driver"" };" \n
                         "if (SR_Debug) then { diag_log format[""%1 %2 %3"",""DCS: "", _vehicle, "" waiting for driver""] };" \n
                         "" \n
                         "//private _i = -1;" \n
                         "private _future = time + 5*60;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
